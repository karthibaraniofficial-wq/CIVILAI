# CIVILAI — Environment Configuration Template
# Populate these variables in a local .env file.
# NEVER commit your actual .env file or real secrets to version control.

# Frontend Variables (Public Browser Scope)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend Database & Supabase (Server-side Only)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# AI Model Credentials (Server-side Only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Backend Security & Auth (Server-side Only)
JWT_SECRET=

# Server Environment & Settings
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Hackathon Presentation Demo Settings
DEMO_MODE=True
SIMULATED_SLA_ACCELERATION=60
