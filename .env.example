# CIVICFLOW AI — Environment Configuration

# Environment Mode
ENVIRONMENT=development
DEBUG=True

# Backend Server
PORT=8000
HOST=0.0.0.0

# Multi-Agent AI (Gemini 3.8 Flash)
# Optional for demo mode; if omitted, the resilient heuristic engine handles triage
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Database & Supabase Persistence
# Optional for demo mode; if omitted, the platform uses embedded in-memory persistence
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Hackathon Presentation Demo Settings
DEMO_MODE=True
SIMULATED_SLA_ACCELERATION=60
